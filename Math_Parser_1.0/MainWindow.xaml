<Window x:Class="Math_Parser_1._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:UserControls="clr-namespace:Math_Parser_1._0.View.UserControls"
        xmlns:local="clr-namespace:Math_Parser_1._0"
       
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner">
 
    <Grid>
      <!--main area-->
        <Grid x:Name="mainAreaGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/> <!--inmatningsfält-->
                <ColumnDefinition Width="10"/> <!--разделитель-->
                <ColumnDefinition Width="70*"/> <!--graph-->
            </Grid.ColumnDefinitions>
      <!--inmatningsfält-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" >
                <StackPanel Name="InputFields"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Background="Gray" HorizontalAlignment="Stretch"/>
      <!--graph-->
            <UserControls:GraphControl x:Name="graph" Grid.Column="2"/>
            <Button Margin="5" Name="menubtn" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width ="40 " Height="40" Content="=" Click="Menuwindowbtn_Click" Grid.Column="2"/>
            <Button Margin="5, 0, 0, 50" Name="Home" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="40" Height="40" Content="H" Click="Homebtn_Click" Grid.Column="2"/>

        </Grid>
      <!--menuwindow-->
        <Grid Grid.Row="1">
            <UserControls:CustomMenu x:Name="menuControl" Visibility="Hidden"/>
        </Grid>
        
    </Grid>
</Window>

