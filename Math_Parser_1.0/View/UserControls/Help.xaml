<Window x:Class="Math_Parser_1._0.View.UserControls.Help"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Math_Parser_1._0.View.UserControls"
        mc:Ignorable="d"
        Title="Help" Height="450" Width="800">
    <Grid>
        <StackPanel>
           
            <TextBlock Text="Divide: /"/>
            <TextBlock Text="Multiply: *"/>
            <TextBlock Text="Add: +"/>
            <TextBlock Text="Substract: -"/>
            
            <TextBlock Text="Sinus: sin(x)"/>
            <TextBlock Text="Cosinus: cos(x)"/>

            <TextBlock Text="Function: y=x, y=x+5, y=x+5/sin(4)"/>
            <TextBlock Text="Expression: 5+5/4"/>
            <TextBlock Text="Vertical line: x=3"/>
            <TextBlock Text="Horisontal line: y=3"/>

            <TextBlock Text="Shortcuts" FontWeight="Bold"/>
            <TextBlock Text="H or h to open this help window"/>
            <TextBlock Text="M or m to open menu"/>


        </StackPanel>
        
    </Grid>
</Window>
