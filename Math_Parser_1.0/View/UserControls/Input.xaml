<UserControl x:Class="Math_Parser_1._0.View.UserControls.Input"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Math_Parser_1._0.View.UserControls"
             mc:Ignorable="d" 
             Height="50" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button x:Name="btnPlus" FontSize="30" VerticalContentAlignment="Center" Content="+" Padding="0,0,0,10" Click="Plus_Click">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Expression" Click="Expression_Click" />
                    <MenuItem Header="Text" Click="Text_Click"/>
                    <MenuItem Header="Image(!)" Click="Image_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <TextBox x:Name="txtInput" 
                 Grid.Column="1" 
                 VerticalContentAlignment="Center" 
                 FontSize="17" 
                 FontWeight="Light" 
                 KeyDown="TextBox_KeyDown"
                 Background="Transparent"
                 Panel.ZIndex="1"
                 TextChanged="txtInput_TextChanged"
                 />

        <TextBlock x:Name="tblPlaceholder" Grid.Column="1" Text="Inmatningsfält..." FontSize="17" FontWeight="Light" Margin="7, 0, 0, 0" VerticalAlignment="Center" Foreground="DarkGray"/>

        <Button Grid.Column="1" Panel.ZIndex =" 1" x:Name="Radera" Background="Transparent" HorizontalAlignment="Right" FontSize="25" Width="50" Click="Radera_Click">
            <!--<Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Radera" Click="Radera_Click" />
                    <MenuItem Header="Duplicate output" Click="Settings"/>
                </ContextMenu>
            </Button.ContextMenu>-->
            <Image Source="pack://application:,,,/Assets/delete.png" Opacity="0.4"/>
        </Button>
    </Grid>
</UserControl>