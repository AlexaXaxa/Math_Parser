<UserControl x:Class="Math_Parser_1._0.View.UserControls.Output"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Math_Parser_1._0.View.UserControls"
             mc:Ignorable="d" 
             Height="50" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="tblPlaceholder" 
                 Grid.Column="1" 
                 Margin="7, 0, 0, 0" 
                 VerticalAlignment="Center" 
                 
                 Text="" 
                 
                 IsReadOnly="True"
                
                 
                 BorderThickness="0" 
                 Background="Transparent" 
                 Foreground="DarkGray"  FontSize="17" FontWeight="Light"/>

    </Grid>
</UserControl>
