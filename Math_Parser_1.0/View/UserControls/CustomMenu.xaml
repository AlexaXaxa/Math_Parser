<UserControl x:Class="Math_Parser_1._0.View.UserControls.CustomMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Math_Parser_1._0.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Background="White" HorizontalAlignment="Right" Width="200">
            <Button Content="Hjälp" Click="Helpbtn"/>
            <Button Content="Feedback"/>
            <Button Content="Om/Licens"/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content="..."/>
            <Button Content=""/>
            <Button Content=""/>
            <TextBlock Text="Version 1.0"/>
            <Button Content="..."/>
            <StackPanel Margin="5">

                <!-- SLIDER -->
                <Slider x:Name="Slider" Minimum="0" Maximum="100" Value="0"  ValueChanged="Slider_ValueChanged"/>

                <!-- КНОПКИ -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="⏪" Click="Rewind15_Click"/>
                    <Button Grid.Column="1" Content="▶" Click="Play_Click"/>
                    <Button Grid.Column="2" Content="⏸" Click="Pause_Click"/>
                    <Button Grid.Column="3" Content="⏩" Click="Forward15_Click" />
                    
                </Grid>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
